# =============================================================================
# DATABASE
# =============================================================================

# Connection URL for this service's own database. The PostgreSQL database name must be
# `solum-pama`, otherwise a "Wrong Database" warning is printed at startup.
# Format: postgresql://<user>:<password>@<host>:<port>/solum-pama
# For an On Premise setup without PostgreSQL, use the SQLite file instead (relative to backend/):
# DATABASE_URL=sqlite:///./data/solum-pama.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/solum-pama

# =============================================================================
# GENERAL
# =============================================================================

# Number of rows returned per page by paginated list endpoints. Defaults to 30 when empty.
LIMIT=30

# Version string returned by the API version endpoint, e.g. 1.0.0
API_VERSION=1.0.0

# Recorded in updated_by on every create/update; the API is public, so there is no logged-in user.
# Defaults to GUEST.
GUEST_USER_CODE=GUEST

# =============================================================================
# SOLUM AIMS
# =============================================================================

# SaaS AIMS API URL, without a trailing slash (replace with the URL from SOLUM),
# e.g. https://<aims-host>.solumesl.com. Default of the SaaS field on the Config tab.
SOLUM_API_URL=https://GANTI-DENGAN-URL-AIMS.solumesl.com

# Default company code (?company=...). The frontend starts with this value; the user can change it.
SOLUM_COMPANY=GANTI_KODE_COMPANY

# Default store code (?store=...), e.g. ST00943. The frontend starts with this value; the user can
# change it. Required by the LED call when the request does not send a store.
SOLUM_STORE=

# Authentication, choose one:
# 1) A token used as is
SOLUM_API_TOKEN=
# 2) Username/password login -> the token is fetched from SOLUM_TOKEN_PATH and cached until it expires
SOLUM_USERNAME=
SOLUM_PASSWORD=
SOLUM_TOKEN_PATH=/common/api/v2/token

# Seconds to wait for SOLUM before a request fails. Defaults to 30.
SOLUM_TIMEOUT_SECONDS=30

# =============================================================================
# SOLUM SERVER (defaults of the Config tab)
# =============================================================================

# Used until the Config tab saves its first value; after that the saved value in ms_config wins and
# these are only shown as the defaults. A change here needs a backend restart.

# Server every SOLUM call goes to: ON_PREMISE (IP + port below) or SAAS (SOLUM_API_URL above).
# Defaults to SAAS.
SOLUM_SERVER_TYPE=SAAS

# On Premise AIMS server address and port, e.g. 192.168.1.100 and 9001.
SOLUM_ON_PREMISE_IP=192.168.1.100
SOLUM_ON_PREMISE_PORT=9001

# Scheme of the On Premise URL (<scheme>://<ip>:<port>), http or https. Defaults to http.
SOLUM_ON_PREMISE_SCHEME=http

# =============================================================================
# SOLUM LED (PUT /common/api/v2/common/articles/led, sent after every ms_stock update)
# =============================================================================

# How long the label LED blinks. Must be one of SOLUM's values: 0s, 10s, 30s, 60s, 1m, 90s, 120s,
# 2m, 150s, 300s, 5m, 600s, 10m, 900s, 15m, 1200s, 20m, 1800s, 30m, 3600s, 60m. Defaults to 60s.
SOLUM_LED_DURATION=60s

# LED blink pattern id (patternId). Defaults to 0.
SOLUM_LED_PATTERN_ID=0

# multiLed flag, true or false. Defaults to false.
SOLUM_LED_MULTI_LED=false

# =============================================================================
# SOLUM PAGE FLIP (On Premise only: POST /labels/contents/page for every label linked to an article)
# =============================================================================

# Seconds between two page changes. Empty or 0 turns it off. Every label linked to an article (read
# from GET /labels) moves to the next page in one call. Applies after a backend restart.
SOLUM_PAGE_FLIP_SECONDS=

# How many pages the label template has (1-7): the labels go 1, 2, ..., this value, then 1 again.
# Defaults to 2. This project uses 5.
SOLUM_PAGE_FLIP_PAGE_COUNT=5

# =============================================================================
# SEARCH DROPDOWN (Store, Article)
# =============================================================================

# Max rows per request to SOLUM's store & article lists (sent as ?size=...). Defaults to 10.
SEARCH_PAGE_SIZE=5
