# ============================================================
#  Backend (solum-pama/backend, FastAPI)
# ============================================================
# Base URL backend tanpa garis miring di akhir. Semua panggilan SOLUM (store, article, data stok, LED)
# dilakukan oleh backend; Company/Store/durasi LED default juga dibaca dari .env backend.
# Prefix NEXT_PUBLIC_ karena dibaca di browser; nilainya ditanam saat `npm run build`, restart `npm run dev` setelah diubah.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================
#  Dropdown pencarian (Article, Store)
# ============================================================
# Jeda (ms) setelah user berhenti mengetik sebelum API dipanggil ulang. Dipakai semua dropdown pencarian.
# Prefix NEXT_PUBLIC_ karena dibaca di browser; restart `npm run dev` setelah diubah.
NEXT_PUBLIC_SEARCH_DEBOUNCE_MS=500
